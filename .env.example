# ─── AI APIs ─────────────────────────────────────────────────────────────────
# xAI (Grok) — for meal plan generation
# Get yours at: https://console.x.ai/
XAI_API_KEY=

# Together AI — for food photo generation (FLUX model)
# Get yours at: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# ─── Auth (next-auth) ─────────────────────────────────────────────────────────
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=

# Your app URL (use http://localhost:3000 for dev)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email OTP ────────────────────────────────────────────────────────────────
# Resend API — https://resend.com/api-keys
RESEND_API_KEY=

# Sender address (must be verified in Resend)
EMAIL_FROM=noreply@yourdomain.com
